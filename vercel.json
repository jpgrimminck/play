{
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/song-upload/publish.js": { "maxDuration": 300 } },
  "headers": [{ "source": "/subir(.*)", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }]
}
